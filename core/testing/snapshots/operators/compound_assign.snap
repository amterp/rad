### TITLE ###
Int assignments
### INPUT ###
a = 1
a += 3 + 4
print(a)
a -= 3 * 2
print(a)
a *= 3
print(a)
a /= 4
print(a)
### STDOUT ###
8
2
6
1.5

### TITLE ###
Float assignments
### INPUT ###
b = 1.5
b += 3.3
print(b)
b -= 2
print(b)
b *= 4
print(b)
b /= 2.5
print(b)
### STDOUT ###
4.8
2.8
11.2
4.4799999999999995

### TITLE ###
String assignments
### INPUT ###
c = "hi"
c += " there"
print(c)
### STDOUT ###
hi there

### TITLE ###
Add int array
### INPUT ###
a = [1]
a += [2]
print(a)
### STDOUT ###
[ 1, 2 ]

### TITLE ###
Add float array
### INPUT ###
a = [1.1]
a += [2.2]
print(a)
### STDOUT ###
[ 1.1, 2.2 ]

### TITLE ###
Add string array
### INPUT ###
a = ["alice"]
a += ["bob"]
print(a)
### STDOUT ###
[ "alice", "bob" ]

### TITLE ###
Subtract from array errors
### INPUT ###
a = [1]
a -= 2
### STDERR ###
error[RAD30002]: Invalid operand types: cannot do 'int[] -= int'
  --> <script>:2:1
  |
1 | a = [1]
2 | a -= 2
  | ^^^^^^
  |
  = info: rad docs RAD30002
### EXIT ###
1

### TITLE ###
Divide from array errors
### INPUT ###
a = [1]
a /= 2
### STDERR ###
error[RAD30002]: Invalid operand types: cannot do 'int[] /= int'
  --> <script>:2:1
  |
1 | a = [1]
2 | a /= 2
  | ^^^^^^
  |
  = info: rad docs RAD30002
### EXIT ###
1

### TITLE ###
Multiply from array errors
### INPUT ###
a = [1]
a *= 2
### STDERR ###
error[RAD30002]: Invalid operand types: cannot do 'int[] *= int'
  --> <script>:2:1
  |
1 | a = [1]
2 | a *= 2
  | ^^^^^^
  |
  = info: rad docs RAD30002
### EXIT ###
1

### TITLE ###
Errors if append not array
### INPUT ###
a = [1]
a += 2
### STDERR ###
error[RAD30002]: Invalid operand types: cannot do 'int[] += int'
  --> <script>:2:1
  |
1 | a = [1]
2 | a += 2
  | ^^^^^^
  |
  = help: To append, wrap the right side in a list - e.g. `myList + [item]`.
  = info: rad docs RAD30002
### EXIT ###
1

### TITLE ###
Add through collection
### INPUT ###
a = [1, 2]
a[1] += 2
print(a)
### STDOUT ###
[ 1, 4 ]

### TITLE ###
Add through nested collection
### INPUT ###
a = { "alice": [1, 2], "bob": [3, 4] }
a["alice"][0] += 2
a.bob[1] += 2
print(a)
### STDOUT ###
{ "alice": [ 3, 2 ], "bob": [ 3, 6 ] }

### TITLE ###
Accumulates into fn local shadowing a module variable
### INPUT ###
tally = ["module"]

fn f():
	tally = []
	tally += ["from-fn"]
	return tally

print(f())
print(tally)
### STDOUT ###
[ "from-fn" ]
[ "module" ]

### TITLE ###
Fn local shadowing a builtin leaves the builtin callable
### INPUT ###
fn collect():
	keys = []
	keys += [1]
	return keys

print(collect())
print(keys({"a": 1}))
### STDOUT ###
[ 1 ]
[ "a" ]

### TITLE ###
Accumulates into a param shadowing a module variable
### INPUT ###
n = 100

fn bump(n):
	n += 1
	return n

print(bump(1))
print(n)
### STDOUT ###
2
100

### TITLE ###
Accumulates into fn local from inside if and for bodies
### INPUT ###
total = 0

fn sum_evens(limit):
	total = 0
	for i in range(limit):
		if i % 2 == 0:
			total += i
	return total

print(sum_evens(6))
print(total)
### STDOUT ###
6
0

### TITLE ###
Without a fn local, still writes the enclosing binding
### INPUT ###
total = 0

fn add(x):
	total += x

add(3)
add(4)
print(total)
### STDOUT ###
7
