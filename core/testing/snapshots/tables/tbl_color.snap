### TITLE ###
RadColor_NonOverlappingMatches
### INPUT ###
url = "https://google.com"
name = json[].name
city = json[].city
rad url:
    fields name, city
    city:
       color "red" "Los"
       color "blue" "Angeles"
### ARGS ###
--mock-response
.*:./responses/people.json
--color=always
### STDOUT ###
\"\x1b[33mname   \x1b[0m  \x1b[33mcity       \x1b[0m "
\"Charlie  Paris        "
\"Bob      London       "
\"Alice    New York     "
\"Bob      \x1b[31mLos\x1b[0m \x1b[34mAngeles\x1b[0m  "
### STDERR ###
Mocking response for url (matched ".*"): https://google.com

### TITLE ###
RadColor_OverlappingMatches
### INPUT ###
url = "https://google.com"
name = json[].name
city = json[].city
rad url:
    fields name, city
    city:
       color "red" "New"
       color "blue" "York"
       color "yellow" "New York"
### ARGS ###
--mock-response
.*:./responses/people.json
--color=always
### STDOUT ###
\"\x1b[33mname   \x1b[0m  \x1b[33mcity       \x1b[0m "
\"Charlie  Paris        "
\"Bob      London       "
\"Alice    \x1b[33mNew York\x1b[0m     "
\"Bob      Los Angeles  "
### STDERR ###
Mocking response for url (matched ".*"): https://google.com

### TITLE ###
RadColor_PartialOverlapPriority
### INPUT ###
url = "https://google.com"
name = json[].name
city = json[].city
rad url:
    fields name, city
    name:
       color "blue" "Bo"
       color "red" "ob"
### ARGS ###
--mock-response
.*:./responses/people.json
--color=always
### STDOUT ###
\"\x1b[33mname   \x1b[0m  \x1b[33mcity       \x1b[0m "
\"Charlie  Paris        "
\"\x1b[34mB\x1b[0m\x1b[31mob\x1b[0m      London       "
\"Alice    New York     "
\"\x1b[34mB\x1b[0m\x1b[31mob\x1b[0m      Los Angeles  "
### STDERR ###
Mocking response for url (matched ".*"): https://google.com

