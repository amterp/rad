### TITLE ###
[F9][F10] Leading and trailing comments
### INPUT ###
// leading
x = 1 // trailing
### FORMATTED ###
// leading
x = 1 // trailing

### TITLE ###
[F6][F8] Multiple blank lines collapse to one
### INPUT ###
a = 1



b = 2
### FORMATTED ###
a = 1

b = 2

### TITLE ###
[F7] Blank lines stripped at file edges
### INPUT ###



x = 1
### FORMATTED ###
x = 1

### TITLE ###
[F9] Comment inside block
### INPUT ###
if x:
    // note
    print(1)
### FORMATTED ###
if x:
    // note
    print(1)

### TITLE ###
[F9] Standalone comment between statements
### INPUT ###
a = 1
// a section
b = 2
### FORMATTED ###
a = 1
// a section
b = 2

### TITLE ###
[F11] Comment trailing a block header stays on the header line
### INPUT ###
if x: // why this
    a = 1
for i in xs: // each item
    print(i)
### FORMATTED ###
if x: // why this
    a = 1
for i in xs: // each item
    print(i)
