#!/usr/bin/env rad

stdout = quiet $`sysctl -n machdep.cpu.brand_string`
cpu = replace(stdout, "\n", "")

stdout = quiet $`sysctl -n hw.memsize`
ram = replace(stdout, "\n", "")
ram = parse_int(ram) / 1024 / 1024 / 1024


stdout = quiet $`sysctl -n hw.ncpu`
cores = replace(stdout, "\n", "")

stdout = quiet $`sw_vers -productVersion`
macos_vers = replace(stdout, "\n", "")

print("{cpu} ({cores} cores) {ram} GB macOS {macos_vers}")
